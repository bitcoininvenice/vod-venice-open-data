# ==============================================================================
# VOD: Venice Open Data - Variabili d'ambiente (copiare in .env, mai committare .env)
# ==============================================================================

# Database locale (docker compose) - scegliere una password robusta
POSTGRES_DB="venice_opendata"
POSTGRES_USER="vod_user"
POSTGRES_PASSWORD=""
DATABASE_URL="postgresql://vod_user:CAMBIAMI@localhost:5432/venice_opendata"

# ACTV GTFS statici (Open Data ACTV, CC BY - citare la fonte)
GTFS_NAV_URL="https://actv.avmspa.it/sites/default/files/attachments/opendata/navigazione/actv_nav.zip"
GTFS_AUT_URL="https://actv.avmspa.it/sites/default/files/attachments/opendata/automobilistico/actv_aut.zip"

# ACTV GTFS-Realtime (licenza d'uso da confermare con AVM S.p.A.)
GTFS_RT_NAV_POSITIONS="https://tpl.actv.it/nav/GTFSRT/vehiclePositions"
GTFS_RT_AUT_POSITIONS="https://tpl.actv.it/aut/GTFSRT/vehiclePositions"

# OpenSky Network (facoltativo): credenziali OAuth2 client-credentials per una quota più alta
# OPENSKY_CLIENT_ID=""
# OPENSKY_CLIENT_SECRET=""

# Navi AIS in tempo reale (aisstream.io, chiave gratuita): valore vero solo in web/.env.local e su Vercel
# AISSTREAM_API_KEY=""
# Spazi sportivi CAMPO (API GeoJSON, CC BY 4.0): indirizzo definitivo in HTTPS quando disponibile
# CAMPO_API_URL="https://<dominio-campo>/api/v1/markers/geojson"
