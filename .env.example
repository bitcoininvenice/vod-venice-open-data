# ==============================================================================
# VOD: Venice Open Data - Environment Variables
# ==============================================================================

# Database Connection (PostgreSQL 16 + PostGIS 3.4)
DATABASE_URL="postgresql://vod_user:vod_password@localhost:5432/venice_opendata"

# Next.js Port (Default: 3000)
PORT=3000

# ACTV GTFS Open Data Source URLs
GTFS_NAV_URL="http://actv.avmspa.it/sites/default/files/attachments/opendata/navigazione/actv_nav.zip"
GTFS_AUT_URL="http://actv.avmspa.it/sites/default/files/attachments/opendata/automobilistico/actv_aut.zip"

# ACTV GTFS-RT Real-Time Endpoints
GTFS_RT_NAV_POSITIONS="https://tpl.actv.it/nav/GTFSRT/vehiclePositions"
GTFS_RT_NAV_TRIP_UPDATES="https://tpl.actv.it/nav/GTFSRT/tripUpdates"
GTFS_RT_AUT_POSITIONS="https://tpl.actv.it/aut/GTFSRT/vehiclePositions"
GTFS_RT_AUT_TRIP_UPDATES="https://tpl.actv.it/aut/GTFSRT/tripUpdates"

# Comune di Venezia Open Data Portal
COMUNE_OPENDATA_URL="https://dati.venezia.it/"
