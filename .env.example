# VOD – Venice Open Data: variabili facoltative per la pipeline Python (pipeline/)
# Optional variables for the Python pipeline. Copy to .env if you need them; never commit .env.
# Senza variabili la pipeline usa gli indirizzi ufficiali delle fonti. / Without them the pipeline uses the official source URLs.

# Orario ACTV GTFS (CC BY) / ACTV GTFS timetable
# GTFS_NAV_URL="https://actv.avmspa.it/sites/default/files/attachments/opendata/navigazione/actv_nav.zip"
# GTFS_AUT_URL="https://actv.avmspa.it/sites/default/files/attachments/opendata/automobilistico/actv_aut.zip"

# Istanza Overpass (OpenStreetMap) da provare per prima / Overpass instance to try first
# OVERPASS_URL="https://overpass-api.de/api/interpreter"

# File alternativi del Comune di Venezia / Alternative City of Venice files
# OPERE_PUBBLICHE_URL=""
# WIFI_HOTSPOTS_URL=""
