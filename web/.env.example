# VOD – Venice Open Data: variabili d'ambiente del sito (tutte facoltative)
# Site environment variables (all optional): the site works without any of them.
# Valori veri solo in web/.env.local e nelle impostazioni di Vercel, mai nel repository.
# Real values only in web/.env.local and in the Vercel settings, never in the repository.

# Indirizzo pubblico del sito: link, sitemap, metadati, llms.txt, pagina /mcp e skill.
# Su Vercel, se manca, si usa il dominio di produzione del progetto; altrimenti l'indirizzo di VOD.
# Public site URL: links, sitemap, metadata, llms.txt, /mcp page and skill.
# On Vercel, when unset, the project's production domain is used; otherwise VOD's address.
# NEXT_PUBLIC_SITE_URL="https://venice-open-data.vercel.app"

# Repository del codice sorgente, linkato in fondo alla mappa e alle pagine (richiesto dalla AGPL-3.0 a chi
# pubblica una versione modificata) / Source code repository linked at the bottom of the map and pages
# (required by the AGPL-3.0 for anyone publishing a modified version)
# NEXT_PUBLIC_SOURCE_URL="https://github.com/bitcoininvenice/vod-venice-open-data"

# Navi AIS in tempo reale (aisstream.io, chiave gratuita) / Live AIS ships (aisstream.io, free key)
# AISSTREAM_API_KEY=""
# Tempo di ascolto del flusso AIS per ogni lettura, in millisecondi / AIS listening time per read, ms
# AISSTREAM_LISTEN_MS="15000"

# OpenSky Network: credenziali OAuth2 per la quota giornaliera più alta (solo lato server)
# OpenSky Network: OAuth2 client credentials for the higher daily quota (server side only)
# OPENSKY_CLIENT_ID=""
# OPENSKY_CLIENT_SECRET=""

# Limiti di richieste per IP al minuto / Requests per IP per minute
# API_RATE_LIMIT_PER_MINUTE="600"
# MCP_RATE_LIMIT_PER_MINUTE="60"

# Mapillary (foto a livello strada): chiave «client token» gratuita da https://www.mapillary.com/dashboard/developers.
# Resta sul server: le richieste passano da /api/mapillary. Senza chiave il livello mostra un avviso.
# MAPILLARY_TOKEN=""
