# ==============================================================================
# VOD - Venice Open Data: Vercel Environment Variables
# (Tutte le variabili sono facoltative: l'app funziona out-of-the-box anche senza)
# ==============================================================================

# URL di produzione Vercel (facoltativo)
# NEXT_PUBLIC_APP_URL="https://venice-open-data.vercel.app"

# Database Cloud PostgreSQL + PostGIS (facoltativo: Neon, Supabase, Vercel Postgres)
# DATABASE_URL="postgresql://user:password@ep-cool-fog-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# OpenSky Network (facoltativo): credenziali OAuth2 per una quota API più alta (solo lato server)
# OPENSKY_CLIENT_ID=""
# OPENSKY_CLIENT_SECRET=""

# Limite di richieste alle API per IP al minuto (default 600)
# API_RATE_LIMIT_PER_MINUTE="600"

# PostHog Analytics (facoltativo) - se attivato serve consenso/informativa privacy (GDPR)
# NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
# Navi AIS in tempo reale (aisstream.io, chiave gratuita): mettere il valore vero solo in .env.local e su Vercel
# AISSTREAM_API_KEY=""